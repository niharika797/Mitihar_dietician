# Patient app — copy to .env and fill in values
# EXPO_PUBLIC_ prefix exposes vars to the JS bundle (visible to users — no secrets here).
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# EAS project ID — get from your Expo dashboard after running 'eas build:configure'
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
