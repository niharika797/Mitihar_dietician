# Doctor/Admin dashboard — copy to .env and fill in values
# VITE_ prefix is required for Vite to expose vars to the browser bundle.
VITE_API_URL=http://localhost:8000/api/v1

# Dev-only quick-login credentials (stripped from production builds by Vite).
# Credentials must match ADMIN_SEED_* and TEST_DOCTOR_* in the backend .env.
VITE_DEV_ADMIN_EMAIL=admin@example.com
VITE_DEV_ADMIN_PASSWORD=CHANGE_ME
VITE_DEV_DOCTOR_EMAIL=doctor@example.com
VITE_DEV_DOCTOR_PASSWORD=CHANGE_ME
