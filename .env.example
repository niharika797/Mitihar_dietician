# ── Mityahar Backend — Environment Variables Template ────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@localhost:5432/mityahar_db
POSTGRES_PASSWORD=CHANGE_ME

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Cookie security ───────────────────────────────────────────────────────────
# False for local HTTP dev. Set True in production (HTTPS required).
COOKIE_SECURE=False

# ── Dev-only flags ────────────────────────────────────────────────────────────
# Hard-delete endpoint for wiping test patient accounts. MUST be False in production.
ALLOW_HARD_DELETE=False

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# ── Gemini AI (nutrition estimation) ─────────────────────────────────────────
# ── Redis (rate limiter — required for multi-worker/production) ─────────────
# Leave blank for single-worker local dev. Set for production (--workers > 1).
REDIS_URL=redis://localhost:6379

GEMINI_API_KEY_1=your-gemini-api-key
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4

# ── USDA FoodData (used only by seed_6k_recipes.py) ─────────────────────────
# Get free key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-api-key

# ── Seed scripts (local dev only — not used by the server) ───────────────────
# CANONICAL admin — both seed scripts should point to the same email
# so only one admin account exists in the database.
ADMIN_SEED_EMAIL=admin@mityahar.com
ADMIN_SEED_PASSWORD=CHANGE_ME_strong_password
ADMIN_SEED_NAME=Super Admin
# TEST_ADMIN_* must match ADMIN_SEED_* to prevent a second rogue admin being created
TEST_ADMIN_EMAIL=admin@mityahar.com
TEST_ADMIN_PASSWORD=CHANGE_ME_strong_password
# Doctor
TEST_DOCTOR_EMAIL=dr.ashok.mehta@mitihar.test
TEST_DOCTOR_PASSWORD=CHANGE_ME_strong_password
